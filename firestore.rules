rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read any user profile (for public donate pages)
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    
    // Donations: anyone can create, only owner can read
    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null;
    }
    
    // Notifications: only owner can read/write
    match /notifications/{notifId} {
      allow read, write: if request.auth != null && 
        request.auth.uid == resource.data.uid;
      allow create: if true; // Allow server to create
    }
    
    // Withdraws: only owner can read/create
    match /withdraws/{withdrawId} {
      allow read: if request.auth != null && 
        request.auth.uid == resource.data.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null; // Admin updates
    }
  }
}
